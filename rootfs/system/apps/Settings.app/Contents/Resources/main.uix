<?xml version="1.0" encoding="UTF-8"?>
<!-- The Settings window: a sidebar of panes, as GNOME Settings has, each pane's controls in one place, of which the
     sidebar shows one pane at a time. main.lua applies and saves each choice. -->
<UIScript version="1" requires="sidebar panes">
  <Window width="380" height="444"/>
  <Sidebar name="panes" width="130"/>
  <Pane name="appearance" title="Appearance"/>
  <Pane name="dock" title="Dock"/>
  <Pane name="clock" title="Clock"/>
  <Pane name="developer" title="Developer"/>

  <Style name="heading" fontSize="title"/>
  <Style name="quiet" textColor="secondaryText"/>

  <!-- The accent swatches, GNOME's nine, in DesktopPalette.Swatches' order. A test keeps them in step. -->
  <Style name="swatch1" backgroundColor="#3584E4"/>
  <Style name="swatch2" backgroundColor="#2190A4"/>
  <Style name="swatch3" backgroundColor="#3A944A"/>
  <Style name="swatch4" backgroundColor="#C88800"/>
  <Style name="swatch5" backgroundColor="#ED5B00"/>
  <Style name="swatch6" backgroundColor="#E62D42"/>
  <Style name="swatch7" backgroundColor="#D56199"/>
  <Style name="swatch8" backgroundColor="#9141AC"/>
  <Style name="swatch9" backgroundColor="#6F8396"/>

  <!-- The swatches' names, from _1_settings.cst beside this file. -->
  <String name="swatch1Name" table="1" index="1"/>
  <String name="swatch2Name" table="1" index="2"/>
  <String name="swatch3Name" table="1" index="3"/>
  <String name="swatch4Name" table="1" index="4"/>
  <String name="swatch5Name" table="1" index="5"/>
  <String name="swatch6Name" table="1" index="6"/>
  <String name="swatch7Name" table="1" index="7"/>
  <String name="swatch8Name" table="1" index="8"/>
  <String name="swatch9Name" table="1" index="9"/>
  <String name="utcOffsetHint" table="1" index="10"/>

  <!-- Appearance. -->
  <Text name="styleHeading" pane="appearance" x="12" y="10" width="356" height="24" style="heading" text="Style"/>
  <Button name="light" pane="appearance" x="12" y="40" width="84" height="26" text="Light"/>
  <Button name="dark" pane="appearance" x="102" y="40" width="84" height="26" text="Dark"/>
  <Button name="auto" pane="appearance" x="192" y="40" width="84" height="26" text="Auto"/>

  <!-- When Auto is dark, by the clock; dark runs overnight when it starts later than it ends. -->
  <Text name="darkFromLabel" pane="appearance" x="12" y="77" width="70" height="20" text="Dark from"/>
  <TextField name="darkFrom" pane="appearance" x="84" y="74" width="60" height="26" placeholder="19:00"/>
  <Text name="darkUntilLabel" pane="appearance" x="152" y="77" width="36" height="20" text="until"/>
  <TextField name="darkUntil" pane="appearance" x="190" y="74" width="60" height="26" placeholder="07:00"/>

  <Text name="accentHeading" pane="appearance" x="12" y="114" width="356" height="24" style="heading" text="Accent color"/>
  <Button name="swatch1" pane="appearance" x="12" y="144" width="32" height="36" style="swatch1" tooltip="swatch1Name"/>
  <Button name="swatch2" pane="appearance" x="52" y="144" width="32" height="36" style="swatch2" tooltip="swatch2Name"/>
  <Button name="swatch3" pane="appearance" x="92" y="144" width="32" height="36" style="swatch3" tooltip="swatch3Name"/>
  <Button name="swatch4" pane="appearance" x="132" y="144" width="32" height="36" style="swatch4" tooltip="swatch4Name"/>
  <Button name="swatch5" pane="appearance" x="172" y="144" width="32" height="36" style="swatch5" tooltip="swatch5Name"/>
  <Button name="swatch6" pane="appearance" x="212" y="144" width="32" height="36" style="swatch6" tooltip="swatch6Name"/>
  <Button name="swatch7" pane="appearance" x="252" y="144" width="32" height="36" style="swatch7" tooltip="swatch7Name"/>
  <Button name="swatch8" pane="appearance" x="292" y="144" width="32" height="36" style="swatch8" tooltip="swatch8Name"/>
  <Button name="swatch9" pane="appearance" x="332" y="144" width="32" height="36" style="swatch9" tooltip="swatch9Name"/>

  <Text name="accentName" pane="appearance" x="12" y="186" width="356" height="20" style="quiet"/>
  <TextField name="custom" pane="appearance" x="12" y="216" width="120" height="26" placeholder="#RRGGBB"/>
  <Text name="status" pane="appearance" x="142" y="219" width="226" height="20" style="quiet"/>

  <Text name="cornersHeading" pane="appearance" x="12" y="256" width="356" height="24" style="heading" text="Window corners"/>
  <Button name="rounded" pane="appearance" x="12" y="286" width="84" height="26" text="Rounded"/>
  <Button name="square" pane="appearance" x="102" y="286" width="84" height="26" text="Square"/>

  <!-- The wallpapers, the sky first, as thumbnails; main.lua puts each wallpaper's in its slot and hides the slots
       it doesn't use. Every slot starts with the sky's, which ships beside this file. -->
  <Image name="thumb1" path="Sky.png"/>
  <Image name="thumb2" path="Sky.png"/>
  <Image name="thumb3" path="Sky.png"/>
  <Image name="thumb4" path="Sky.png"/>
  <Image name="thumb5" path="Sky.png"/>
  <Text name="wallpaperHeading" pane="appearance" x="12" y="330" width="356" height="24" style="heading" text="Wallpaper"/>
  <Button name="wallpaper1" pane="appearance" x="12" y="360" width="64" height="48" image="thumb1"/>
  <Button name="wallpaper2" pane="appearance" x="84" y="360" width="64" height="48" image="thumb2"/>
  <Button name="wallpaper3" pane="appearance" x="156" y="360" width="64" height="48" image="thumb3"/>
  <Button name="wallpaper4" pane="appearance" x="228" y="360" width="64" height="48" image="thumb4"/>
  <Button name="wallpaper5" pane="appearance" x="300" y="360" width="64" height="48" image="thumb5"/>
  <Text name="wallpaperName" pane="appearance" x="12" y="414" width="356" height="20" style="quiet"/>

  <!-- Clock: the offset from UTC, typed after the UTC label; there's no daylight saving, so it's changed when the
       clocks change. -->
  <Text name="offsetHeading" pane="clock" x="12" y="10" width="356" height="24" style="heading" text="Offset from UTC"/>
  <Text name="utcLabel" pane="clock" x="12" y="43" width="34" height="20" text="UTC"/>
  <TextField name="utcOffset" pane="clock" x="48" y="40" width="90" height="26" placeholder="-05:00" tooltip="utcOffsetHint"/>
  <Text name="clockShown" pane="clock" x="148" y="43" width="220" height="20" style="quiet"/>

  <!-- Dock: whether it's always there, hides on its own, or hides when a window would cover it. -->
  <Text name="dockHeading" pane="dock" x="12" y="10" width="356" height="24" style="heading" text="Dock"/>
  <Button name="dockAlways" pane="dock" x="12" y="40" width="356" height="26" text="Always visible"/>
  <Button name="dockAutoHide" pane="dock" x="12" y="72" width="356" height="26" text="Hide automatically"/>
  <Button name="dockDodge" pane="dock" x="12" y="104" width="356" height="26" text="Hide when a window covers it"/>
  <FormattedText name="dockAbout" pane="dock" x="12" y="142" width="356" height="60" style="quiet"/>

  <!-- Developer: developer mode, for vdb, which sends apps from another computer while the desktop runs. -->
  <Text name="developerHeading" pane="developer" x="12" y="10" width="356" height="24" style="heading" text="Developer mode"/>
  <Button name="developerOn" pane="developer" x="12" y="40" width="84" height="26" text="On"/>
  <Button name="developerOff" pane="developer" x="102" y="40" width="84" height="26" text="Off"/>
  <FormattedText name="developerAbout" pane="developer" x="12" y="78" width="356" height="60" style="quiet"/>
  <Text name="developerStatus" pane="developer" x="12" y="146" width="356" height="20"/>
</UIScript>
