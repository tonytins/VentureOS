<?xml version="1.0" encoding="UTF-8"?>
<!-- The Settings window: a sidebar of panes, as GNOME Settings has, each pane's controls in one place, of which the
     sidebar shows one pane at a time. main.lua applies and saves each choice. -->
<UIScript version="1">
  <Window width="380" height="269"/>
  <Sidebar name="panes" width="130"/>

  <Style name="heading" fontSize="title"/>
  <Style name="quiet" textColor="secondaryText"/>

  <!-- The accent swatches, GNOME's nine, in DesktopPalette.Swatches' order. A test keeps them in step. -->
  <Style name="swatch1" backgroundColor="#3584E4"/>
  <Style name="swatch2" backgroundColor="#2190A4"/>
  <Style name="swatch3" backgroundColor="#3A944A"/>
  <Style name="swatch4" backgroundColor="#C88800"/>
  <Style name="swatch5" backgroundColor="#ED5B00"/>
  <Style name="swatch6" backgroundColor="#E62D42"/>
  <Style name="swatch7" backgroundColor="#D56199"/>
  <Style name="swatch8" backgroundColor="#9141AC"/>
  <Style name="swatch9" backgroundColor="#6F8396"/>

  <!-- The swatches' names, from _1_settings.cst beside this file. -->
  <String name="swatch1Name" table="1" index="1"/>
  <String name="swatch2Name" table="1" index="2"/>
  <String name="swatch3Name" table="1" index="3"/>
  <String name="swatch4Name" table="1" index="4"/>
  <String name="swatch5Name" table="1" index="5"/>
  <String name="swatch6Name" table="1" index="6"/>
  <String name="swatch7Name" table="1" index="7"/>
  <String name="swatch8Name" table="1" index="8"/>
  <String name="swatch9Name" table="1" index="9"/>
  <String name="utcOffsetHint" table="1" index="10"/>

  <!-- The wallpapers, the sky first, as thumbnails; main.lua puts each wallpaper's in its slot and hides the slots
       it doesn't use. Every slot starts with the sky's, which ships beside this file. -->
  <Image name="thumb1" path="Sky.png"/>
  <Image name="thumb2" path="Sky.png"/>
  <Image name="thumb3" path="Sky.png"/>
  <Image name="thumb4" path="Sky.png"/>
  <Image name="thumb5" path="Sky.png"/>

  <Pane name="appearance" title="Appearance">
    <Text name="styleHeading" x="12" y="10" width="356" height="24" style="heading" text="Style"/>
    <Button name="light" x="12" y="40" width="84" height="26" text="Light"/>
    <Button name="dark" x="102" y="40" width="84" height="26" text="Dark"/>
    <Button name="auto" x="192" y="40" width="84" height="26" text="Auto"/>

    <!-- When Auto is dark, by the clock; dark runs overnight when it starts later than it ends. -->
    <Text name="darkFromLabel" x="12" y="77" width="70" height="20" text="Dark from"/>
    <TextField name="darkFrom" x="84" y="74" width="60" height="26" placeholder="19:00"/>
    <Text name="darkUntilLabel" x="152" y="77" width="36" height="20" text="until"/>
    <TextField name="darkUntil" x="190" y="74" width="60" height="26" placeholder="07:00"/>

    <Text name="accentHeading" x="12" y="114" width="356" height="24" style="heading" text="Accent color"/>
    <Button name="swatch1" x="12" y="144" width="32" height="36" style="swatch1" tooltip="swatch1Name"/>
    <Button name="swatch2" x="52" y="144" width="32" height="36" style="swatch2" tooltip="swatch2Name"/>
    <Button name="swatch3" x="92" y="144" width="32" height="36" style="swatch3" tooltip="swatch3Name"/>
    <Button name="swatch4" x="132" y="144" width="32" height="36" style="swatch4" tooltip="swatch4Name"/>
    <Button name="swatch5" x="172" y="144" width="32" height="36" style="swatch5" tooltip="swatch5Name"/>
    <Button name="swatch6" x="212" y="144" width="32" height="36" style="swatch6" tooltip="swatch6Name"/>
    <Button name="swatch7" x="252" y="144" width="32" height="36" style="swatch7" tooltip="swatch7Name"/>
    <Button name="swatch8" x="292" y="144" width="32" height="36" style="swatch8" tooltip="swatch8Name"/>
    <Button name="swatch9" x="332" y="144" width="32" height="36" style="swatch9" tooltip="swatch9Name"/>

    <Text name="accentName" x="12" y="186" width="356" height="20" style="quiet"/>
    <TextField name="custom" x="12" y="216" width="120" height="26" placeholder="#RRGGBB"/>
    <Text name="status" x="142" y="219" width="226" height="20" style="quiet"/>
<!-- 
    <Text name="cornersHeading" x="12" y="256" width="356" height="24" style="heading" text="Window corners"/>
    <Button name="rounded" x="12" y="286" width="84" height="26" text="Rounded"/>
    <Button name="square" x="102" y="286" width="84" height="26" text="Square"/>
-->
  </Pane>
  
  <Pane name="wallpaper" title="Wallpaper">
     <Text name="wallpaperHeading" x="12" y="24" width="356" height="24" style="heading" text="Wallpaper"/>
    <Button name="wallpaper1" x="12" y="56" width="64" height="48" image="thumb1"/>
    <Button name="wallpaper2" x="84" y="56" width="64" height="48" image="thumb2"/>
    <Button name="wallpaper3" x="156" y="56" width="64" height="48" image="thumb3"/>
    <Button name="wallpaper4" x="228" y="56" width="64" height="48" image="thumb4"/>
    <Button name="wallpaper5" x="300" y="56" width="64" height="48" image="thumb5"/>
    <Text name="wallpaperName" x="12" y="120" width="356" height="20" style="quiet"/>
  </Pane>

  <Pane name="dock" title="Dock">
    <!-- Dock: whether it's always there, hides on its own, or hides when a window would cover it. -->
    <Text name="dockHeading" x="12" y="10" width="356" height="24" style="heading" text="Dock"/>
    <Button name="dockAlways" x="12" y="40" width="356" height="26" text="Always visible"/>
    <Button name="dockAutoHide" x="12" y="72" width="356" height="26" text="Hide automatically"/>
    <Button name="dockDodge" x="12" y="104" width="356" height="26" text="Hide when a window covers it"/>
    <FormattedText name="dockAbout" x="12" y="142" width="356" height="60" style="quiet"/>
  </Pane>

  <Pane name="clock" title="Clock">
    <!-- Clock: the offset from UTC, typed after the UTC label; there's no daylight saving, so it's changed when the
         clocks change. -->
    <Text name="offsetHeading" x="12" y="10" width="356" height="24" style="heading" text="Offset from UTC"/>
    <Text name="utcLabel" x="12" y="43" width="34" height="20" text="UTC"/>
    <TextField name="utcOffset" x="48" y="40" width="90" height="26" placeholder="-05:00" tooltip="utcOffsetHint"/>
    <Text name="clockShown" x="148" y="43" width="220" height="20" style="quiet"/>
  </Pane>

  <Pane name="developer" title="Developer">
    <!-- Developer: developer mode, for vdb, which sends apps from another computer while the desktop runs. -->
    <Text name="developerHeading" x="12" y="10" width="356" height="24" style="heading" text="Developer mode"/>
    <Button name="developerOn" x="12" y="40" width="84" height="26" text="On"/>
    <Button name="developerOff" x="102" y="40" width="84" height="26" text="Off"/>
    <FormattedText name="developerAbout" x="12" y="78" width="356" height="60" style="quiet"/>
    <Text name="developerStatus" x="12" y="146" width="356" height="20"/>
  </Pane>
</UIScript>
