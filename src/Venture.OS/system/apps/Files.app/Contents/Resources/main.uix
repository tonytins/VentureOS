<?xml version="1.0" encoding="UTF-8"?>
<!-- A Files window. main.lua fills the lists and handles the events. -->
<UIScript version="1" requires="menus sidebar">
  <Window width="370" height="300"/>
  <Sidebar name="bookmarks" width="120"/>

  <TitleField name="address" placeholder="Path"/>

  <Menu name="fileMenu" title="File" hotkey="F"/>
  <MenuItem menu="fileMenu" name="openItem" title="Open" hotkey="O" shortcut="Ctrl+O"/>
  <MenuItem menu="fileMenu" name="lookItem" title="Quick Look" hotkey="L" shortcut="Ctrl+Y"/>
  <MenuSeparator menu="fileMenu"/>
  <MenuItem menu="fileMenu" name="closeWindow" title="Close Window" hotkey="C" shortcut="Ctrl+W"/>

  <Menu name="goMenu" title="Go" hotkey="G"/>
  <MenuItem menu="goMenu" name="enclosing" title="Enclosing Folder" hotkey="E" shortcut="Ctrl+U"/>
  <MenuItem menu="goMenu" name="goToFolder" title="Go to Folder…" hotkey="G" shortcut="Ctrl+L"/>

  <Style name="quiet" textColor="#6E747E"/>

  <List name="entries" x="10" y="10" width="350" height="256" selectable="true"/>
  <Text name="status" x="10" y="272" width="350" height="20" alignment="right" style="quiet"/>
</UIScript>
