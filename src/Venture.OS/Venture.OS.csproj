<Project Sdk="Cosmos.Sdk/3.0.94">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <AssemblyName>Venture</AssemblyName>
    <!-- The kernel class lives in Venture.OS.Kernel, not the default <RootNamespace>.Kernel. -->
    <CosmosKernelClass>Venture.OS.Kernel.VentureKernel</CosmosKernelClass>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cosmos.Kernel" Version="3.0.94" />
    <PackageReference Include="Cosmos.Kernel.System" Version="3.0.94" />
    <PackageReference Include="GitInfo" Version="3.6.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Venture.OS.Common/Venture.OS.Common.csproj" />
  </ItemGroup>

  <!--
    Built-in files: everything under system/ and user/ is built into the kernel and installed at boot, to
    /mnt/system (which nothing may change) and /mnt/user (which the user may). Root says which.
    The files become byte arrays in generated C#, so nothing needs loading at run time and no escaping can
    change a script. %(RecursiveDir) keeps the folder layout, such as commands/echo.lua.
  -->
  <ItemGroup>
    <SystemFile Include="system/**/*" Root="system" />
    <SystemFile Include="user/**/*" Root="user" />
    <None Remove="system/**/*;user/**/*" />
  </ItemGroup>

  <!--
    IntermediateOutputPath is only set once the SDK's targets load, so the paths are set in a target.
    The list of files is written out too, only when it changes, so removing a file regenerates the source:
    timestamps alone can't tell that something was deleted.
  -->
  <Target Name="SetSystemFilesSource" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <SystemFilesSource>$(IntermediateOutputPath)SystemFiles.g.cs</SystemFilesSource>
      <SystemFilesList>$(IntermediateOutputPath)SystemFiles.list</SystemFilesList>
    </PropertyGroup>
    <WriteLinesToFile File="$(SystemFilesList)" Lines="@(SystemFile->'%(Root)/%(RecursiveDir)%(Filename)%(Extension)')"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(SystemFilesList)" />
    </ItemGroup>
  </Target>

  <Target Name="GenerateSystemFiles" BeforeTargets="CoreCompile" DependsOnTargets="SetSystemFilesSource"
          Inputs="@(SystemFile);$(SystemFilesList);$(MSBuildProjectFullPath)" Outputs="$(SystemFilesSource)">
    <WriteSystemFilesSource Files="@(SystemFile)" OutputFile="$(SystemFilesSource)" />
  </Target>

  <!-- Runs outside GenerateSystemFiles so the source is compiled even when that target is up to date. -->
  <Target Name="IncludeSystemFiles" BeforeTargets="CoreCompile" DependsOnTargets="GenerateSystemFiles">
    <ItemGroup>
      <Compile Include="$(SystemFilesSource)" />
      <FileWrites Include="$(SystemFilesSource)" />
    </ItemGroup>
  </Target>

  <UsingTask TaskName="WriteSystemFilesSource" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var source = new StringBuilder();
        source.AppendLine("// <auto-generated/> by GenerateSystemFiles in Venture.OS.csproj, from src/Venture.OS/system/ and user/.");
        source.AppendLine("namespace Venture.OS.Startup;");
        source.AppendLine();
        source.AppendLine("internal static class SystemFiles");
        source.AppendLine("{");

        foreach (var (root, field) in new[] { ("system", "All"), ("user", "User") })
        {
            source.AppendLine("    /// <summary>Every file under src/Venture.OS/" + root + "/, by its path relative to that folder.</summary>");
            source.AppendLine("    public static readonly global::Venture.OS.Scripting.EmbeddedFile[] " + field + " =");
            source.AppendLine("    [");

            foreach (var file in Files.Where(item => item.GetMetadata("Root") == root)
                         .OrderBy(item => item.GetMetadata("RecursiveDir") + item.GetMetadata("Filename"), StringComparer.Ordinal))
            {
                var path = (file.GetMetadata("RecursiveDir") + file.GetMetadata("Filename") + file.GetMetadata("Extension")).Replace('\\', '/');
                var bytes = File.ReadAllBytes(file.GetMetadata("FullPath"));
                source.Append("        new(\"").Append(path.Replace("\"", "\\\"")).Append("\", [");
                source.Append(string.Join(", ", bytes.Select(value => value.ToString())));
                source.AppendLine("]),");
            }

            source.AppendLine("    ];");
        }

        source.AppendLine("}");

        Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
        File.WriteAllText(OutputFile, source.ToString());
      ]]></Code>
    </Task>
  </UsingTask>

</Project>