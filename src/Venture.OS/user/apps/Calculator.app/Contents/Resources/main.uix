<?xml version="1.0" encoding="UTF-8"?>
<!-- Calculator's window. main.lua does the arithmetic. -->
<UIScript version="1">
  <Window width="232" height="308"/>

  <Style name="display" fontSize="24" backgroundColor="inputBackground"/>

  <FormattedText name="display" x="12" y="12" width="208" height="42" alignment="right" style="display" text="0"/>
  <Button name="clear" x="12" y="64" width="46" height="40" text="C"/>
  <Button name="sign" x="66" y="64" width="46" height="40" text="±"/>
  <Button name="percent" x="120" y="64" width="46" height="40" text="%"/>
  <Button name="divide" x="174" y="64" width="46" height="40" text="÷"/>
  <Button name="d7" x="12" y="112" width="46" height="40" text="7"/>
  <Button name="d8" x="66" y="112" width="46" height="40" text="8"/>
  <Button name="d9" x="120" y="112" width="46" height="40" text="9"/>
  <Button name="multiply" x="174" y="112" width="46" height="40" text="×"/>
  <Button name="d4" x="12" y="160" width="46" height="40" text="4"/>
  <Button name="d5" x="66" y="160" width="46" height="40" text="5"/>
  <Button name="d6" x="120" y="160" width="46" height="40" text="6"/>
  <Button name="subtract" x="174" y="160" width="46" height="40" text="−"/>
  <Button name="d1" x="12" y="208" width="46" height="40" text="1"/>
  <Button name="d2" x="66" y="208" width="46" height="40" text="2"/>
  <Button name="d3" x="120" y="208" width="46" height="40" text="3"/>
  <Button name="add" x="174" y="208" width="46" height="40" text="+"/>
  <Button name="d0" x="12" y="256" width="100" height="40" text="0"/>
  <Button name="point" x="120" y="256" width="46" height="40" text="."/>
  <Button name="equals" x="174" y="256" width="46" height="40" text="="/>
</UIScript>
