<?xml version="1.0" encoding="UTF-8"?>
<!-- Notes' window. main.lua fills the list and handles the events. -->
<UIScript version="1" requires="menus">
  <Window width="362" height="220"/>

  <ToolbarItem name="add" title="Add"/>
  <ToolbarItem name="remove" title="Remove"/>

  <Menu name="noteMenu" title="Note" hotkey="N"/>
  <MenuItem menu="noteMenu" name="newNote" title="New Note" hotkey="N" shortcut="Ctrl+Shift+N"/>
  <MenuItem menu="noteMenu" name="deleteNote" title="Delete Note" hotkey="D" shortcut="Ctrl+D"/>
  <MenuSeparator menu="noteMenu"/>
  <MenuItem menu="noteMenu" name="clearAll" title="Clear All Notes" hotkey="C"/>

  <TextField name="text" x="14" y="14" width="334" height="24" placeholder="Write a note, then press Enter"/>
  <List name="notes" x="14" y="48" width="334" height="160" selectable="true"/>
</UIScript>
