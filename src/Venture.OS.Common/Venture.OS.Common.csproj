<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Kernel-free code shared by the kernel and the tests. It must not reference Cosmos: anything here
    runs (and is tested) on ordinary .NET, and the kernel compiles it ahead of time.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Venture.OS</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Flags anything that wouldn't survive the kernel's ahead-of-time compile. -->
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
