<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Roundhouse, VentureOS's IDE, for Linux, macOS, and Windows. It draws with VentureOS's own code, so it references
    Venture.OS.Common and Venture.OS.Interface, but they never reference it: Avalonia stays here, and the kernel's
    build doesn't change. See docs/design/2026-11-18-roundhouse-design.md.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Roundhouse</AssemblyName>
    <RootNamespace>Venture.Roundhouse</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Roundhouse shares VentureOS's version, from GitInfo.txt at the repository root, as the kernel does. -->
    <GitIgnoreTagVersion>true</GitIgnoreTagVersion>
    <GitIgnoreBranchVersion>true</GitIgnoreBranchVersion>
    <!-- A placeholder until Roundhouse has its own art; packaging/icons.sh makes it from Assets/Roundhouse.png. -->
    <ApplicationIcon>Assets/Roundhouse.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Approved for Roundhouse only. -->
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <!-- Highlighting for the text beside the canvas, and later for Lua. -->
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <!-- Skia, which Avalonia draws with, at Avalonia's own version: Roundhouse's painter draws text with it. -->
    <PackageReference Include="Avalonia.Skia" Version="12.1.5" />
    <!-- Roundhouse's log, to a file and the Log tab. Approved for Roundhouse only, 2026-11-18. -->
    <PackageReference Include="NLog" Version="6.2.2" />
    <PackageReference Include="GitInfo" Version="3.6.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The window's icon. -->
    <AvaloniaResource Include="Assets/Roundhouse.png" />
    <!-- Grammars for the formats TextMateSharp has none for, read by Highlighting/Grammars. -->
    <EmbeddedResource Include="Highlighting/*.tmLanguage.json" LogicalName="Venture.Roundhouse.Highlighting.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- VentureOS's own fonts, so Roundhouse draws text in the same faces VentureOS does. -->
    <None Include="../../rootfs/system/fonts/*" LinkBase="fonts" CopyToOutputDirectory="PreserveNewest" />
    <!-- What File ▸ New App starts from, beside Roundhouse. -->
    <None Include="Templates/**/*" CopyToOutputDirectory="PreserveNewest" />
    <!-- VentureOS's own files, which Run copies afresh for each run, so a packaged Roundhouse can run VentureOS. -->
    <None Include="../../rootfs/**/*" LinkBase="rootfs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Venture.OS.Common/Venture.OS.Common.csproj" />
    <ProjectReference Include="../Venture.OS.Interface/Venture.OS.Interface.csproj" />
  </ItemGroup>

</Project>
