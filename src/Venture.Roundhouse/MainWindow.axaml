<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:edit="https://github.com/avaloniaui/avaloniaedit"
        x:Class="Venture.Roundhouse.MainWindow"
        Width="1100" Height="720" MinWidth="640" MinHeight="400">
  <DockPanel>
    <!-- Open and Save, then how VentureOS's look is shown: light or dark, and the accent. -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8">
      <Button x:Name="OpenButton" Content="Open…" Click="OnOpenClicked"/>
      <Button x:Name="SaveButton" Content="Save" Click="OnSaveClicked" IsEnabled="False"/>
      <CheckBox x:Name="DarkBox" Content="Dark" Margin="16,0,0,0" IsCheckedChanged="OnLookChanged"/>
      <ComboBox x:Name="AccentBox" MinWidth="120" SelectionChanged="OnLookChanged"/>
    </StackPanel>

    <!-- What the reader said, or that the document reads. -->
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="8,4" TextWrapping="Wrap"
               Text="Open a .uix file to see it as VentureOS draws it."/>

    <Grid ColumnDefinitions="*,4,*">
      <edit:TextEditor x:Name="Editor" Grid.Column="0" ShowLineNumbers="True" FontFamily="Cascadia Code,Fira Code,monospace"
                       FontSize="13" TextChanged="OnTextChanged"/>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns"/>
      <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Image x:Name="PreviewImage" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"/>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
