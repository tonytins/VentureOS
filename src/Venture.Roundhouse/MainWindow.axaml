<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:edit="https://github.com/avaloniaui/avaloniaedit"
        xmlns:designer="using:Venture.Roundhouse.Designer"
        xmlns:local="using:Venture.Roundhouse"
        x:Class="Venture.Roundhouse.MainWindow"
        Icon="/Assets/Roundhouse.png"
        Width="1100" Height="720" MinWidth="640" MinHeight="400">
  <Window.Resources>
    <!--
      Where the bar is the title bar on Linux, Avalonia draws the window's frame (as Passenger has it do) so the window
      manager doesn't add its own title bar above. The frame keeps its edges for resizing and draws nothing else:
      the bar holds the title and the buttons.
    -->
    <ControlTheme x:Key="FrameOnly" TargetType="WindowDrawnDecorations">
      <Setter Property="DefaultTitleBarHeight" Value="44"/>
      <Setter Property="DefaultFrameThickness" Value="4"/>
      <Setter Property="DefaultShadowThickness" Value="0"/>
      <Setter Property="Template">
        <WindowDrawnDecorationsTemplate>
          <WindowDrawnDecorationsContent/>
        </WindowDrawnDecorationsTemplate>
      </Setter>
    </ControlTheme>
  </Window.Resources>

  <Window.Styles>
    <!-- VentureOS's window buttons: bare dots, as its own title bar draws them. -->
    <Style Selector="Border#TitleBar Button.light">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border#TitleBar Button.light:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Opacity" Value="0.8"/>
    </Style>
    <Style Selector="Border#TitleBar Button.light:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Opacity" Value="0.6"/>
    </Style>
    <!-- The bar's buttons sit on its colour, so they're flat and white, and only show themselves under the pointer. -->
    <Style Selector="Border#TitleBar :is(Button).bar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border#TitleBar :is(Button).bar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Border#TitleBar :is(Button).bar:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#4DFFFFFF"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Border#TitleBar ToggleButton.bar:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#40FFFFFF"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Border#TitleBar :is(Button).bar:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#80FFFFFF"/>
    </Style>

    <!-- Tool windows are headed in small capitals, as IDEs head them. -->
    <Style Selector="TextBlock.pane">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="0.6"/>
      <Setter Property="Opacity" Value="0.7"/>
      <Setter Property="Margin" Value="10,8,10,6"/>
    </Style>
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
      <Setter Property="MinWidth" Value="1"/>
      <Setter Property="MinHeight" Value="1"/>
    </Style>
  </Window.Styles>

  <DockPanel>
    <!--
      The coloured bar, after Passenger's and other .NET IDEs': VentureOS's blue running into its teal, laid out as
      VentureOS's own title bar is: the window's buttons and the start items at the left, the document's name centred
      with its bundle under it, and the end items at the right. Where the desktop allows, it's the window's title bar.
    -->
    <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="44" DoubleTapped="OnTitleBarDoubleTapped">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
          <GradientStop Color="#3584E4" Offset="0"/>
          <GradientStop Color="#2190A4" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <local:TitleBarPanel x:Name="TitleBarContent" Margin="10,0">
        <StackPanel x:Name="StartItems" Orientation="Horizontal" Spacing="2">
          <!-- VentureOS's red close, orange minimize, and green zoom, drawn where Roundhouse draws the frame. -->
          <StackPanel x:Name="WindowButtons" Orientation="Horizontal" Spacing="8" Margin="0,0,12,0" VerticalAlignment="Center"
                      IsVisible="False">
            <Button x:Name="CloseButton" Classes="light" Click="OnCloseClicked" ToolTip.Tip="Close">
              <Ellipse x:Name="CloseDot" Width="12" Height="12"/>
            </Button>
            <Button x:Name="MinimizeButton" Classes="light" Click="OnMinimizeClicked" ToolTip.Tip="Minimize">
              <Ellipse x:Name="MinimizeDot" Width="12" Height="12"/>
            </Button>
            <Button x:Name="MaximizeButton" Classes="light" Click="OnMaximizeClicked" ToolTip.Tip="Zoom">
              <Ellipse x:Name="ZoomDot" Width="12" Height="12"/>
            </Button>
          </StackPanel>
          <Button x:Name="MenuButton" Classes="bar" Content="☰" FontSize="16" Click="OnMenuClicked" ToolTip.Tip="Menu"/>
          <Button x:Name="AddButton" Classes="bar" Content="Add ▾" IsEnabled="False" ToolTip.Tip="Add a control"/>
          <Button x:Name="UndoButton" Classes="bar" Content="↶" FontSize="16" Click="OnUndoClicked" IsEnabled="False"
                  ToolTip.Tip="Undo (Ctrl+Z)"/>
          <Button x:Name="RedoButton" Classes="bar" Content="↷" FontSize="16" Click="OnRedoClicked" IsEnabled="False"
                  ToolTip.Tip="Redo (Ctrl+Shift+Z)"/>
        </StackPanel>
        <StackPanel x:Name="TitleStack" VerticalAlignment="Center" IsHitTestVisible="False">
          <!--
            The document and its app on one line, such as "main.uix — Calculator.app", in the font's own line height,
            so no glyph is cut.
          -->
          <TextBlock x:Name="DocumentTitle" Text="Roundhouse" Foreground="White" FontWeight="SemiBold" FontSize="13"
                     HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel x:Name="EndItems" Orientation="Horizontal" Spacing="2">
          <Button x:Name="RunButton" Classes="bar" Content="▶ Run" Click="OnRunClicked" ToolTip.Tip="Run in VentureOS (Ctrl+R)"/>
          <ToggleButton x:Name="ZoomToggle" Classes="bar" Content="2×" IsCheckedChanged="OnZoomChanged"
                        ToolTip.Tip="Twice the size (Ctrl+=)"/>
          <ToggleButton x:Name="TextToggle" Classes="bar" Content="Text" IsChecked="True" IsCheckedChanged="OnTextToggled"
                        ToolTip.Tip="Show the text"/>
        </StackPanel>
      </local:TitleBarPanel>
    </Border>

    <!-- What the reader said, or that the document reads, and where the caret is. -->
    <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" Margin="10,3">
        <TextBlock x:Name="StatusText" FontSize="12" TextTrimming="CharacterEllipsis"
                   Text="Open a .uix file to see it as VentureOS draws it."/>
        <TextBlock x:Name="CaretText" Grid.Column="1" FontSize="12" Opacity="0.7" Margin="16,0,0,0"/>
      </Grid>
    </Border>

    <!-- Outline, canvas over text, inspector: after Xcode's Interface Builder. -->
    <Grid ColumnDefinitions="210,1,*,1,270">
      <!-- The bundle's files over the open interface's outline, when a bundle is open. -->
      <Grid x:Name="LeftPane" Grid.Column="0" RowDefinitions="*,1,*" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <DockPanel x:Name="FilesPane" Grid.Row="0" IsVisible="False">
          <TextBlock DockPanel.Dock="Top" Classes="pane" Text="FILES"/>
          <TreeView x:Name="FileTree" Background="Transparent" SelectionChanged="OnFileSelected">
            <TreeView.Styles>
              <!-- Every folder open. -->
              <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="True"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="4,2"/>
              </Style>

            </TreeView.Styles>
          </TreeView>
        </DockPanel>
        <GridSplitter x:Name="FilesSplitter" Grid.Row="1" ResizeDirection="Rows" IsVisible="False"/>
        <DockPanel x:Name="OutlinePane" Grid.Row="2">
          <TextBlock DockPanel.Dock="Top" Classes="pane" Text="OUTLINE"/>
          <TextBlock x:Name="OutlineHint" DockPanel.Dock="Top" Text="Open a document to see its elements." TextWrapping="Wrap"
                     Opacity="0.6" Margin="10,0"/>
          <ListBox x:Name="OutlineList" Background="Transparent" SelectionChanged="OnOutlineSelected" KeyDown="OnDesignKeyDown">
            <ListBox.Styles>
              <!-- An outline is read as a list of names, so its rows are compact. -->
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="10,3"/>
                <Setter Property="MinHeight" Value="0"/>
              </Style>
            </ListBox.Styles>
          </ListBox>
        </DockPanel>
      </Grid>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns"/>

      <Grid x:Name="CenterGrid" Grid.Column="2" RowDefinitions="*,1,240">
        <ScrollViewer x:Name="CanvasScroller" Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <!-- The selection is drawn over the canvas by Roundhouse, never into VentureOS's pixels. -->
          <LayoutTransformControl x:Name="CanvasZoom" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
            <Grid x:Name="CanvasHost" Background="Transparent" Focusable="True"
                  PointerPressed="OnCanvasPressed" PointerMoved="OnCanvasMoved" PointerReleased="OnCanvasReleased"
                  KeyDown="OnCanvasKeyDown">
              <Image x:Name="PreviewImage" Stretch="None" RenderOptions.BitmapInterpolationMode="None"/>
              <Canvas x:Name="SelectionLayer" IsHitTestVisible="False"/>
            </Grid>
          </LayoutTransformControl>
        </ScrollViewer>
        <GridSplitter x:Name="TextSplitter" Grid.Row="1" ResizeDirection="Rows"/>
        <edit:TextEditor x:Name="Editor" Grid.Row="2" ShowLineNumbers="True" FontFamily="Cascadia Code,Fira Code,monospace"
                         FontSize="13" TextChanged="OnTextChanged"/>
      </Grid>
      <!-- A bundle's other files: text, such as Lua, in an editor of its own, and pictures as they are. -->
      <edit:TextEditor x:Name="FileEditor" Grid.Column="2" IsVisible="False" ShowLineNumbers="True"
                       FontFamily="Cascadia Code,Fira Code,monospace" FontSize="13" TextChanged="OnFileTextChanged"/>
      <ScrollViewer x:Name="ImageView" Grid.Column="2" IsVisible="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Image x:Name="FileImage" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
               RenderOptions.BitmapInterpolationMode="None"/>
      </ScrollViewer>
      <!-- A file Roundhouse shows no editor for. -->
      <TextBlock x:Name="FilePlaceholder" Grid.Column="2" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextWrapping="Wrap" TextAlignment="Center" Opacity="0.6" Margin="40"/>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns"/>
      <DockPanel x:Name="InspectorPane" Grid.Column="4" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <TextBlock DockPanel.Dock="Top" Classes="pane" Text="INSPECTOR"/>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="10,0">
            <TextBlock x:Name="InspectorHint" Text="Select an element to see its attributes." TextWrapping="Wrap" Opacity="0.6"/>
            <designer:InspectorPanel x:Name="Inspector" Margin="0,0,10,10"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
