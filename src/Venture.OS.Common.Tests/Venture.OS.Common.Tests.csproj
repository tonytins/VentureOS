<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Venture.OS.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runs on Microsoft.Testing.Platform, opted into by global.json at the repository root. -->
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Venture.OS.Common/Venture.OS.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The kernel's Lua system files, so tests run the scripts that actually ship. -->
    <None Include="../Venture.OS/system/**/*" LinkBase="system" CopyToOutputDirectory="PreserveNewest" />
    <!-- The app tutorial, whose examples are built and run, so the guide can't drift from what works. -->
    <None Include="../../docs/writing-apps.md" Link="docs/writing-apps.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
