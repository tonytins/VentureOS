<?xml version="1.0" encoding="UTF-8"?>
<!-- The Settings window: a sidebar of panes, as GNOME Settings has, each pane's controls in one place, of which the
     sidebar shows one pane at a time. Choices among pictures and colors are grids, after macOS's Appearance.
     main.lua applies and saves each choice. -->
<UIScript version="1">
  <Window width="430" height="492" minWidth="430" minHeight="492" resizable="true"/>
  <Sidebar name="panes" width="130"/>

  <Style name="heading" fontSize="title"/>
  <Style name="quiet" textColor="secondaryText"/>

  <!-- The swatches' names, from _1_settings.cst; the last is the custom color's hover text. -->
  <String name="swatch1Name" table="1" index="1"/>
  <String name="swatch2Name" table="1" index="2"/>
  <String name="swatch3Name" table="1" index="3"/>
  <String name="swatch4Name" table="1" index="4"/>
  <String name="swatch5Name" table="1" index="5"/>
  <String name="swatch6Name" table="1" index="6"/>
  <String name="swatch7Name" table="1" index="7"/>
  <String name="swatch8Name" table="1" index="8"/>
  <String name="swatch9Name" table="1" index="9"/>
  <String name="utcOffsetHint" table="1" index="10"/>
  <String name="customName" table="1" index="11"/>

  <!-- Pictures of each style and kind of scroll bar, drawn by Previews/previews.sh, and the sky's, for the wallpapers. -->
  <Image name="styleAuto" path="StyleAuto.png"/>
  <Image name="styleLight" path="StyleLight.png"/>
  <Image name="styleDark" path="StyleDark.png"/>
  <Image name="scrollClassic" path="ScrollClassic.png"/>
  <Image name="scrollAutomatic" path="ScrollAutomatic.png"/>
  <Image name="sky" path="Sky.png"/>

  <Pane name="appearance" title="Appearance">
    <Text name="styleHeading" x="12" y="10" width="406" height="24" style="heading" text="Style"/>
    <Grid name="styles" x="12" y="38" width="406" height="116" itemWidth="112" itemHeight="72" spacing="16"
          edgeOffsetLeft="12" edgeOffsetRight="12">
      <Item name="auto" image="styleAuto" title="Auto"/>
      <Item name="light" image="styleLight" title="Light"/>
      <Item name="dark" image="styleDark" title="Dark"/>
    </Grid>

    <!-- When Auto is dark, by the clock, shown while Auto is chosen; dark runs overnight when it starts later than it
         ends. -->
    <Text name="darkFromLabel" x="12" y="163" width="70" height="20" text="Dark from"/>
    <TextField name="darkFrom" x="84" y="160" width="60" height="26" placeholder="19:00"/>
    <Text name="darkUntilLabel" x="152" y="163" width="36" height="20" text="until"/>
    <TextField name="darkUntil" x="190" y="160" width="60" height="26" placeholder="07:00"/>

    <!-- GNOME's nine accents, in DesktopPalette.Swatches' order, which main.lua's table and a test keep in step, and a
         custom color, typed in the field it shows. -->
    <Text name="accentHeading" x="12" y="198" width="406" height="24" style="heading" text="Accent color"/>
    <Grid name="accents" x="12" y="226" width="406" height="68" itemWidth="28" itemHeight="28" spacing="10"
          titles="selected" edgeOffsetLeft="12" edgeOffsetRight="12">
      <Item name="blue" color="#3584E4" string="swatch1Name"/>
      <Item name="teal" color="#2190A4" string="swatch2Name"/>
      <Item name="green" color="#3A944A" string="swatch3Name"/>
      <Item name="yellow" color="#C88800" string="swatch4Name"/>
      <Item name="orange" color="#ED5B00" string="swatch5Name"/>
      <Item name="red" color="#E62D42" string="swatch6Name"/>
      <Item name="pink" color="#D56199" string="swatch7Name"/>
      <Item name="purple" color="#9141AC" string="swatch8Name"/>
      <Item name="slate" color="#6F8396" string="swatch9Name"/>
      <Item name="custom" title="+" tooltip="customName"/>
    </Grid>
    <TextField name="customAccent" x="12" y="298" width="120" height="26" placeholder="#RRGGBB"/>
    <Text name="status" x="142" y="301" width="276" height="20" style="quiet"/>

    <Text name="scrollBarsHeading" x="12" y="336" width="406" height="24" style="heading" text="Scroll bars"/>
    <Grid name="scrollBars" x="12" y="364" width="406" height="116" itemWidth="112" itemHeight="72" spacing="16"
          edgeOffsetLeft="12" edgeOffsetRight="12">
      <Item name="classic" image="scrollClassic" title="Classic"/>
      <Item name="automatic" image="scrollAutomatic" title="Automatic"/>
    </Grid>
<!-- Turning these back on needs the window taller.
    <Text name="cornersHeading" x="12" y="492" width="356" height="24" style="heading" text="Window corners"/>
    <Button name="rounded" x="12" y="522" width="84" height="26" text="Rounded"/>
    <Button name="square" x="102" y="522" width="84" height="26" text="Square"/>
-->
  </Pane>

  <Pane name="wallpaper" title="Wallpaper">
    <!-- Every wallpaper, the sky first; main.lua fills them, and the grid scales each picture down. -->
    <Text name="wallpaperHeading" x="12" y="10" width="406" height="24" style="heading" text="Wallpaper"/>
    <Grid name="wallpapers" x="12" y="38" width="406" height="442" itemWidth="128" itemHeight="96" spacing="12"
          edgeOffsetLeft="12" edgeOffsetRight="12" edgeOffsetTop="38" edgeOffsetBottom="34"/>
    <Text name="wallpaperStatus" x="12" y="464" width="406" height="20" style="quiet"
          edgeOffsetLeft="12" edgeOffsetRight="12" edgeOffsetBottom="8"/>
  </Pane>

  <Pane name="dock" title="Dock">
    <!-- Dock: whether it's always there, hides on its own, or hides when a window would cover it. -->
    <Text name="dockHeading" x="12" y="10" width="356" height="24" style="heading" text="Dock"/>
    <Button name="dockAlways" x="12" y="40" width="356" height="26" text="Always visible"/>
    <Button name="dockAutoHide" x="12" y="72" width="356" height="26" text="Hide automatically"/>
    <Button name="dockDodge" x="12" y="104" width="356" height="26" text="Hide when a window covers it"/>
    <FormattedText name="dockAbout" x="12" y="142" width="356" height="60" style="quiet"/>
  </Pane>

  <Pane name="clock" title="Clock">
    <!-- Clock: the offset from UTC, typed after the UTC label; there's no daylight saving, so it's changed when the
         clocks change. -->
    <Text name="offsetHeading" x="12" y="10" width="356" height="24" style="heading" text="Offset from UTC"/>
    <Text name="utcLabel" x="12" y="43" width="34" height="20" text="UTC"/>
    <TextField name="utcOffset" x="48" y="40" width="90" height="26" placeholder="-05:00" tooltip="utcOffsetHint"/>
    <Text name="clockShown" x="148" y="43" width="220" height="20" style="quiet"/>
  </Pane>

  <Pane name="startup" title="Startup">
    <!-- Startup: the apps that open with the desktop, after Files and the Dock, as macOS's login items do. An app may
         also ask, which adds it here when you say yes. -->
    <Text name="startupHeading" x="12" y="10" width="406" height="24" style="heading" text="Open at startup"/>
    <FormattedText name="startupAbout" x="12" y="38" width="406" height="44" style="quiet" edgeOffsetRight="12"/>
    <List name="startupItems" x="12" y="88" width="406" height="110" selectable="true" edgeOffsetRight="12"/>
    <Button name="removeStartup" x="12" y="204" width="90" height="26" text="Remove"/>
    <Text name="addHeading" x="12" y="246" width="406" height="20" text="Add an app"/>
    <List name="installedApps" x="12" y="270" width="406" height="150" selectable="true" edgeOffsetRight="12"/>
    <Button name="addStartup" x="12" y="426" width="90" height="26" text="Add"/>
    <Text name="startupStatus" x="110" y="430" width="308" height="20" style="quiet" edgeOffsetRight="12"/>
  </Pane>

  <Pane name="developer" title="Developer">
    <!-- Developer: developer mode, for vdb, which sends apps from another computer while the desktop runs. -->
    <Text name="developerHeading" x="12" y="10" width="356" height="24" style="heading" text="Developer mode"/>
    <Button name="developerOn" x="12" y="40" width="84" height="26" text="On"/>
    <Button name="developerOff" x="102" y="40" width="84" height="26" text="Off"/>
    <FormattedText name="developerAbout" x="12" y="78" width="356" height="60" style="quiet"/>
    <Text name="developerStatus" x="12" y="146" width="356" height="20"/>
  </Pane>
</UIScript>
